# ==============================================================================
# InsurTech Platform - Environment Variables Template (.env.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env na raiz do projeto: `cp .env.example .env`
# 2. Modifique os valores conforme seu ambiente (desenvolvimento, homologação ou produção).
# 3. O arquivo .env é ignorado pelo Git para proteger credenciais e segredos locais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRAESTRUTURA & BANCO DE DADOS (PostgreSQL, Redis, Kafka)
# ------------------------------------------------------------------------------
POSTGRES_USER=insurtech
POSTGRES_PASSWORD=insurtech
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# ------------------------------------------------------------------------------
# 2. SEGURANÇA & AUTENTICAÇÃO (JWT)
# ------------------------------------------------------------------------------
# Chave secreta HMAC-SHA256 codificada em Base64 (mínimo de 256 bits).
# ATENÇÃO: Em produção, gere uma chave criptograficamente segura com `openssl rand -base64 32`.
JWT_SECRET=dGhpcy1pcy1hLXNlY3VyZS1hbmQtc3VmaWNpZW50bHktbG9uZy1zZWNyZXQta2V5LWZvci1qd3QtMjU2LWJpdHM=
# Tempo de expiração do token em milissegundos (86400000 = 24 horas)
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# 3. PORTAS DOS MICROSSERVIÇOS (Localhost & Docker Compose)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
AUTH_PORT=8084
SEGURADOS_PORT=8085
APOLICES_PORT=8086
SINISTROS_PORT=8087
NOTIFICACAO_PORT=8089
FRONTEND_PORT=5173
KAFKA_UI_PORT=8082

# ------------------------------------------------------------------------------
# 4. URLs DE INTEGRAÇÃO DOS SERVIÇOS (Para execução local fora do Docker)
# ------------------------------------------------------------------------------
SERVICES_AUTH_URL=http://localhost:8084
SERVICES_SEGURADOS_URL=http://localhost:8085
SERVICES_APOLICES_URL=http://localhost:8086
SERVICES_SINISTROS_URL=http://localhost:8087
SERVICES_NOTIFICACAO_URL=http://localhost:8089

# ------------------------------------------------------------------------------
# 5. FRONTEND (Vite / React)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api/v1
VITE_APP_NAME="InsurTech"
VITE_APP_ENV=development
